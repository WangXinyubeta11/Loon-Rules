# NAME: Apple AI
# DESCRIPTION: Siri / Apple Intelligence / Private Cloud Compute / ChatGPT Extension
# UPDATED: 2026-09-19
#
# Apple official reference:
# https://support.apple.com/en-us/101555
#
# Purpose:
# Route Siri, Apple Intelligence, Private Cloud Compute,
# Apple relay services and ChatGPT integration through
# a supported-region proxy.

# ========================================
# Siri / Dictation / Search
# ========================================

DOMAIN,guzzoni.apple.com
DOMAIN-SUFFIX,smoot.apple.com
DOMAIN,seed.siri.apple.com

# ========================================
# Apple Intelligence / Private Cloud Compute
# ========================================

DOMAIN,apple-relay.cloudflare.com
DOMAIN,apple-relay.fastly-edge.com
DOMAIN,cp4.cloudflare.com

# ========================================
# Apple Intelligence Extensions
# ========================================

DOMAIN,apple-relay.apple.com

# ========================================
# Apple Intelligence / Additional Services
# ========================================

DOMAIN,gspe1-ssl.ls.apple.com
DOMAIN,apple-relay.mask.apple-dns.net

# ========================================
# Apple Gateway / Relay / Mask
# ========================================

DOMAIN,gateway.icloud.com
DOMAIN,gateway.fe2.apple-dns.net

DOMAIN,mask-api.fe.apple-dns.net
DOMAIN,mask-api.icloud.com
DOMAIN,mask-t.apple-dns.net
DOMAIN,mask.apple-dns.net
DOMAIN,mask-h2.icloud.com
DOMAIN,mask.icloud.com

# ========================================
# Siri / Apple Intelligence CDN
# ========================================

DOMAIN-SUFFIX,v.aaplimg.com
DOMAIN,seed-siri-apple-com.v.aaplimg.com
DOMAIN,smoot-searchv2-aapse1c.v.aaplimg.com

# ========================================
# ChatGPT / OpenAI Integration
# ========================================

DOMAIN-SUFFIX,chatgpt.com
DOMAIN-SUFFIX,openai.com
DOMAIN-SUFFIX,oaistatic.com
DOMAIN-SUFFIX,oaiusercontent.com
DOMAIN-SUFFIX,oaistatsig.com
